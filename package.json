{
	"name": "docs-view",
	"displayName": "Docs View with Offline Python Reference",
	"description": "Cursor-following documentation and instant offline Python library search in the same view.",
	"version": "0.2.0",
	"publisher": "faycalki",
	"keywords": [
		"documentation",
		"docs",
		"hover",
		"sidebar",
		"panel"
	],
	"galleryBanner": {
		"color": "4C4C4C",
		"theme": "dark"
	},
	"icon": "icon.png",
	"engines": {
		"vscode": "^1.75.0"
	},
	"categories": [
		"Other"
	],
	"repository": {
		"type": "git",
		"url": "https://github.com/faycalki/vscode-docs-view.git"
	},
	"bugs": "https://github.com/faycalki/vscode-docs-view/issues",
	"main": "./dist/extension",
	"extensionKind": [
		"ui",
		"workspace"
	],
	"contributes": {
		"views": {
			"explorer": [
				{
					"type": "webview",
					"id": "docsView.documentation",
					"name": "Documentation",
					"contextualTitle": "Documentation"
				}
			]
		},
		"commands": [
			{
				"command": "docsView.documentationView.pin",
				"title": "Pin Current Documentation",
				"icon": "$(pin)",
				"category": "Docs View"
			},
			{
				"command": "docsView.documentationView.unpin",
				"title": "Unpin Current Documentation",
				"icon": "$(pinned)",
				"category": "Docs View"
			},
			{
				"command": "docsView.searchPythonReference",
				"title": "Search Python Reference",
				"category": "Docs View",
				"icon": "$(search)"
			},
			{
				"command": "docsView.indexEnvironment",
				"title": "Index Python Environment",
				"category": "Docs View"
			},
			{
				"command": "docsView.useBundledReference",
				"title": "Use Bundled Python Reference",
				"category": "Docs View"
			}
		],
		"menus": {
			"commandPalette": [
				{
					"command": "docsView.documentationView.pin",
					"when": "!docsView.documentationView.isPinned"
				},
				{
					"command": "docsView.documentationView.unpin",
					"when": "docsView.documentationView.isPinned"
				}
			],
			"view/title": [
				{
					"command": "docsView.documentationView.pin",
					"when": "view == docsView.documentation && !docsView.documentationView.isPinned",
					"group": "navigation"
				},
				{
					"command": "docsView.documentationView.unpin",
					"when": "view == docsView.documentation && docsView.documentationView.isPinned",
					"group": "navigation"
				},
				{
					"command": "docsView.searchPythonReference",
					"when": "view == docsView.documentation",
					"group": "navigation@1"
				}
			]
		},
		"configuration": {
			"title": "Docs View",
			"properties": {
				"docsView.documentationView.updateMode": {
					"type": "string",
					"description": "Controls how the documentation view is updated when the cursor moves.",
					"default": "live",
					"enum": [
						"live",
						"sticky"
					],
					"enumDescriptions": [
						"The documentation view tracks the current cursor position. Display empty content if no documentation is found at the current position.",
						"The documentation view tries to show the documentation at the current cursor position. If there is none, it continues showing the last available documentation."
					]
				},
				"docsView.pythonReference.enabled": {
					"type": "boolean",
					"default": true,
					"description": "Show bundled Python reference entries when the cursor is on a recognized symbol."
				}
			}
		},
		"keybindings": [
			{
				"command": "docsView.searchPythonReference",
				"key": "ctrl+alt+j",
				"mac": "cmd+alt+j"
			},
			{
				"command": "docsView.completeSearch",
				"key": "tab",
				"when": "inQuickOpen && docsView.referencePicker"
			}
		]
	},
	"scripts": {
		"vscode:prepublish": "python3 scripts/unpack.py && webpack --mode production",
		"webpack": "npm run vscode:prepublish",
		"webpack-dev": "webpack --mode development --watch",
		"lint": "eslint ./src/**/*.ts",
		"pretest": "python3 scripts/unpack.py",
		"test": "node --test test/*.test.js"
	},
	"dependencies": {
		"json5": "^2.1.3",
		"marked": "^11.1.0",
		"shiki": "^0.14.7"
	},
	"devDependencies": {
		"@types/json5": "0.0.30",
		"@types/node": "^14.11.2",
		"@types/vscode": "^1.75.0",
		"@typescript-eslint/eslint-plugin": "^6.19.0",
		"@typescript-eslint/parser": "^6.19.0",
		"eslint": "^8.56.0",
		"ts-loader": "^8.0.4",
		"typescript": "^5.3.0",
		"webpack": "^5.72.0",
		"webpack-cli": "^4.9.0"
	},
	"activationEvents": [
		"onUri"
	],
	"capabilities": {
		"untrustedWorkspaces": {
			"supported": "limited",
			"description": "Bundled documentation and search are available. Indexing a Python environment requires workspace trust."
		}
	}
}
