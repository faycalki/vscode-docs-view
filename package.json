{
	"name": "python-syntax-shelf",
	"displayName": "Python Syntax Shelf",
	"description": "Instant offline syntax and documentation for Python, NumPy, pandas, SciPy, scikit-learn and more, in files and Jupyter notebooks.",
	"version": "0.4.1",
	"publisher": "faycalki",
	"license": "MIT",
	"keywords": [
		"python",
		"jupyter",
		"documentation",
		"numpy",
		"pandas",
		"scikit-learn",
		"scipy",
		"offline"
	],
	"galleryBanner": {
		"color": "#2b203b",
		"theme": "dark"
	},
	"icon": "icon.png",
	"engines": {
		"vscode": "^1.75.0"
	},
	"categories": [
		"Other"
	],
	"repository": {
		"type": "git",
		"url": "https://github.com/faycalki/vscode-docs-view.git"
	},
	"bugs": "https://github.com/faycalki/vscode-docs-view/issues",
	"main": "./dist/extension",
	"extensionKind": [
		"ui",
		"workspace"
	],
	"contributes": {
		"views": {
			"explorer": [
				{
					"type": "webview",
					"id": "pythonSyntaxShelf.documentation",
					"name": "Documentation",
					"contextualTitle": "Python Syntax Shelf"
				}
			]
		},
		"commands": [
			{
				"command": "pythonSyntaxShelf.documentationView.pin",
				"title": "Pin Current Documentation",
				"icon": "$(pin)",
				"category": "Python Syntax Shelf"
			},
			{
				"command": "pythonSyntaxShelf.documentationView.unpin",
				"title": "Unpin Current Documentation",
				"icon": "$(pinned)",
				"category": "Python Syntax Shelf"
			},
			{
				"command": "pythonSyntaxShelf.searchPythonReference",
				"title": "Search Python Reference",
				"category": "Python Syntax Shelf",
				"icon": "$(search)"
			},
			{
				"command": "pythonSyntaxShelf.indexEnvironment",
				"title": "Index Python Environment",
				"category": "Python Syntax Shelf"
			},
			{
				"command": "pythonSyntaxShelf.useBundledReference",
				"title": "Use Bundled Python Reference",
				"category": "Python Syntax Shelf"
			}
		],
		"menus": {
			"commandPalette": [
				{
					"command": "pythonSyntaxShelf.documentationView.pin",
					"when": "!pythonSyntaxShelf.documentationView.isPinned && !pythonSyntaxShelf.showingSearch"
				},
				{
					"command": "pythonSyntaxShelf.documentationView.unpin",
					"when": "pythonSyntaxShelf.documentationView.isPinned && !pythonSyntaxShelf.showingSearch"
				}
			],
			"view/title": [
				{
					"command": "pythonSyntaxShelf.documentationView.pin",
					"when": "view == pythonSyntaxShelf.documentation && !pythonSyntaxShelf.documentationView.isPinned && !pythonSyntaxShelf.showingSearch",
					"group": "navigation"
				},
				{
					"command": "pythonSyntaxShelf.documentationView.unpin",
					"when": "view == pythonSyntaxShelf.documentation && pythonSyntaxShelf.documentationView.isPinned && !pythonSyntaxShelf.showingSearch",
					"group": "navigation"
				},
				{
					"command": "pythonSyntaxShelf.searchPythonReference",
					"when": "view == pythonSyntaxShelf.documentation",
					"group": "navigation@1"
				}
			]
		},
		"configuration": {
			"title": "Python Syntax Shelf",
			"properties": {
				"pythonSyntaxShelf.pythonReference.enabled": {
					"type": "boolean",
					"default": true,
					"description": "Show bundled Python reference entries when the cursor is on a recognized symbol."
				},
				"pythonSyntaxShelf.documentationView.autoOpen": {
					"type": "boolean",
					"default": true,
					"description": "Automatically reveal Documentation at startup and when you return to editing a file or notebook cell. Keyboard focus stays in the editor."
				}
			}
		},
		"keybindings": [
			{
				"command": "pythonSyntaxShelf.searchPythonReference",
				"key": "ctrl+alt+j",
				"mac": "cmd+alt+j"
			},
			{
				"command": "pythonSyntaxShelf.completeSearch",
				"key": "tab",
				"when": "inQuickOpen && pythonSyntaxShelf.referencePicker"
			}
		]
	},
	"scripts": {
		"vscode:prepublish": "python3 scripts/unpack.py && webpack --mode production",
		"webpack": "npm run vscode:prepublish",
		"package": "vsce package --githubBranch master",
		"release:zip": "npm run package && python3 scripts/release_kit.py",
		"webpack-dev": "webpack --mode development --watch",
		"lint": "eslint ./src/**/*.ts",
		"pretest": "python3 scripts/unpack.py",
		"test": "node --test test/*.test.js && python3 test/release_version_test.py"
	},
	"dependencies": {
		"json5": "^2.1.3",
		"marked": "^11.1.0",
		"shiki": "^0.14.7"
	},
	"devDependencies": {
		"@types/json5": "0.0.30",
		"@types/node": "^14.11.2",
		"@types/vscode": "^1.75.0",
		"@typescript-eslint/eslint-plugin": "^6.19.0",
		"@typescript-eslint/parser": "^6.19.0",
		"@vscode/vsce": "4.1.0",
		"eslint": "^8.56.0",
		"ts-loader": "^8.0.4",
		"typescript": "^5.3.0",
		"webpack": "^5.72.0",
		"webpack-cli": "^4.9.0"
	},
	"activationEvents": [
		"onStartupFinished",
		"onNotebook:jupyter-notebook",
		"onUri"
	],
	"capabilities": {
		"untrustedWorkspaces": {
			"supported": "limited",
			"description": "Bundled documentation and search are available. Indexing a Python environment requires workspace trust."
		}
	}
}
